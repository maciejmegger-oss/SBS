# Konfiguracja lokalna — skopiuj do pliku `.env` i uzupełnij własnymi wartościami.
# Plik `.env` jest w .gitignore i nie trafia do repozytorium.
# Pełna instrukcja: docs/KONFIGURACJA-LOGOWANIA.md

# --- Aplikacja w przeglądarce -----------------------------------------------
# Przedrostek VITE_ oznacza, że zmienna trafia do kodu wysyłanego do przeglądarki.
# Klucz `anon` jest do tego przeznaczony — sam z siebie nie daje dostępu do
# danych, dopóki obowiązują reguły dostępu z supabase/rls_authenticated.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Funkcje serwerowe (katalog api/) ---------------------------------------
# Te zmienne NIE mają przedrostka VITE_ i celowo nie trafiają do przeglądarki.
# SUPABASE_SERVICE_ROLE_KEY omija wszystkie reguły dostępu i daje pełną władzę
# nad bazą — nigdy nie dodawaj do niego przedrostka VITE_ i nie umieszczaj go
# w kodzie aplikacji. Bez niego nie działa zapraszanie i usuwanie użytkowników.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
